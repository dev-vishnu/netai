{
  "name": "@netai/next",
  "version": "0.1.0",
  "description": "Next.js adapter for netai: scans app/, serves the agent, and wires the chat to the router.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "netai": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@netai/core": "0.1.0",
    "@netai/react": "0.1.0"
  },
  "peerDependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "next": "^16.4.6",
    "react": "^19.3.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dev-vishnu/netai.git",
    "directory": "packages/next"
  },
  "homepage": "https://github.com/dev-vishnu/netai#readme",
  "keywords": [
    "agent",
    "ai",
    "nextjs",
    "ai-sdk",
    "llm",
    "tool-calling",
    "agentic"
  ],
  "publishConfig": {
    "access": "public"
  }
}
