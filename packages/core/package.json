{
  "name": "@netai/core",
  "version": "0.1.0",
  "description": "Turn a web app's route tree into a filesystem an agent can browse and act on.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "peerDependencies": {
    "ai": "^7.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "ai": "^7.0.181",
    "zod": "^4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dev-vishnu/netai.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/dev-vishnu/netai#readme",
  "keywords": [
    "agent",
    "ai",
    "nextjs",
    "ai-sdk",
    "llm",
    "tool-calling",
    "agentic"
  ],
  "publishConfig": {
    "access": "public"
  }
}
