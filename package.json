{
  "name": "netai-workspace",
  "private": true,
  "type": "module",
  "workspaces": ["packages/core", "packages/react", "packages/next", "examples/*"],
  "scripts": {
    "build": "npm run build -w @netai/core -w @netai/react -w @netai/next",
    "test": "npm test -w @netai/core -w @netai/next",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsup": "^9.0.0",
    "typescript": "5.9.3",
    "vitest": "^5.1.1"
  },
  "engines": { "node": ">=22" }
}
